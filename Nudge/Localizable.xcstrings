    "Experimental: a silent file is requested. The system may play its default sound; vibration is not guaranteed. Verify on a real iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: a silent file is requested. The system may play its default sound; vibration is not guaranteed. Verify on a real iPhone."
